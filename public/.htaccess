Options -Indexes -MultiViews
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Apache sits behind the hosting HTTPS proxy.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^ https://xn--80aa3arm.xn--p1ai%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} !^xn--80aa3arm\.xn--p1ai$ [NC]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^ https://xn--80aa3arm.xn--p1ai%{REQUEST_URI} [R=301,L,NE]

  # Old static entry URLs must not load an obsolete runtime.
  RewriteRule ^(about|members|clusters|projects|committees|events|news|videos|frolov)\.html$ /$1 [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Only generated, existing routes get a SPA shell. Unknown URLs stay HTTP 404.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index|404)\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
